FROM golang:1.23-alpine

WORKDIR /app

# Install git (required for some Go modules)
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod ./

# Initialize go.sum if it doesn't exist and tidy dependencies
RUN go mod tidy

# Copy source code
COPY . .

# Tidy again after copying all files to ensure consistency
RUN go mod tidy

# Build the application
RUN go build -o main .

# Expose port
EXPOSE 8080

# Run the application with hot reload in development
CMD ["go", "run", "main.go"] 