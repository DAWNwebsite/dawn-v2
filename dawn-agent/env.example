# Enhanced AIDA Agent Configuration
# Copy this file to .env and fill in your actual API keys

# Groq API Configuration (Primary LLM)
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
AIDA_MODEL_NAME=llama-3.1-70b-versatile
AIDA_TEMPERATURE=0.1
AIDA_MAX_TOKENS=4000

# Diagnostic Thresholds (0-100 scale)
ADHD_THRESHOLD=65.0
DYSLEXIA_THRESHOLD=60.0
AUTISM_THRESHOLD=70.0
