// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  role              String    @default("student")
  dateOfBirth       DateTime?
  hasParentalConsent Boolean  @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  learningProfile LearningProfile?
  diagnosticResults DiagnosticResult[]
  parentalConsent ParentalConsent?
  accessibilityPreferences AccessibilityPreferences?
  userProgress UserProgress[]
  sentMessages Message[]
  conversationParticipants ConversationParticipant[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LearningProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  learningDisabilities  Json     // ["ADHD", "Dyslexia", "Autism"] - stored as JSON
  learningStyle         String?  // "Visual", "Auditory", "Kinesthetic"
  difficultyLevel       String   @default("beginner") // "beginner", "intermediate", "advanced"
  preferredSubjects     Json     // stored as JSON array
  accommodations        Json     // stored as JSON array
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiagnosticResult {
  id                String   @id @default(cuid())
  userId            String
  assessmentType    String   // "ADHD", "Dyslexia", "Autism"
  score             Float
  confidence        Float
  indicators        Json     // Key indicators found - stored as JSON
  recommendations   Json     // Recommended accommodations - stored as JSON
  completedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ParentalConsent {
  id                    String   @id @default(cuid())
  userId                String   @unique
  parentName            String
  parentEmail           String
  relationshipToChild   String
  consentGiven          Boolean  @default(false)
  consentDate           DateTime?
  ipAddress             String?
  userAgent             String?
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccessibilityPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  highContrast          Boolean  @default(false)
  largeText             Boolean  @default(false)
  reducedMotion         Boolean  @default(false)
  screenReader          Boolean  @default(false)
  keyboardNavigation    Boolean  @default(false)
  colorBlindFriendly    Boolean  @default(false)
  dyslexiaFriendly      Boolean  @default(false)
  focusIndicators       Boolean  @default(true)
  simplifiedLayout      Boolean  @default(false)
  textToSpeech          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningModule {
  id              String   @id @default(cuid())
  title           String
  description     String?
  subject         String   // "Math", "Reading", "Science", etc.
  targetAudience  String   // "elementary", "middle", "high", "adult"
  difficultyLevel String   @default("beginner") // "beginner", "intermediate", "advanced"
  estimatedTime   Int?     // Estimated time in minutes
  isActive        Boolean  @default(true)
  order           Int      @default(0) // For sequencing modules
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contentBlocks   ContentBlock[]
  userProgress    UserProgress[]

  @@index([subject, targetAudience])
  @@index([order])
}

model ContentBlock {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  order           Int      // Order within the module
  contentType     String   // "text", "video", "audio", "interactive_exercise"
  contentData     Json     // JSONB field for flexible content storage
  difficultyLevel String   @default("beginner") // "beginner", "intermediate", "advanced"
  isRequired      Boolean  @default(true)
  estimatedTime   Int?     // Estimated time in minutes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  module          LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userProgress    UserProgress[]

  @@index([moduleId, order])
  @@index([contentType])
}

model UserProgress {
  id              String   @id @default(cuid())
  userId          String
  moduleId        String?  // Optional: for module-level progress
  contentBlockId  String?  // Optional: for content-block-level progress
  status          String   @default("not_started") // "not_started", "in_progress", "completed", "skipped"
  score           Float?   // Optional score (0-100)
  timeSpent       Int?     // Time spent in seconds
  attempts        Int      @default(0)
  lastAccessed    DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          LearningModule?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contentBlock    ContentBlock?    @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId], name: "user_module_progress")
  @@unique([userId, contentBlockId], name: "user_content_progress")
  @@index([userId, status])
  @@index([lastAccessed])
}

model Conversation {
  id          String   @id @default(cuid())
  subject     String?  // Optional conversation subject/topic
  type        String   @default("general") // "general", "academic", "behavioral", "administrative"
  status      String   @default("active") // "active", "archived", "closed"
  priority    String   @default("normal") // "low", "normal", "high", "urgent"
  isConfidential Boolean @default(false) // For sensitive conversations
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastActivity DateTime @default(now())

  messages    Message[]
  participants ConversationParticipant[]

  @@index([status, lastActivity])
  @@index([type, priority])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String   // "student", "parent", "teacher", "admin"
  canMessage     Boolean  @default(true)
  canModerate    Boolean  @default(false)
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  messageType    String   @default("text") // "text", "file", "system", "notification"
  isEdited       Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  readBy         Json     // Array of user IDs who have read this message - stored as JSON
  metadata       Json?    // For storing file attachments, formatting, etc.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([isDeleted, createdAt])
} 