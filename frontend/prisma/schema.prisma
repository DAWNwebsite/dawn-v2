// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime? @map("email_verified")
  image              String?
  role               String    @default("student")
  dateOfBirth        DateTime? @map("date_of_birth")
  hasParentalConsent Boolean   @default(false) @map("has_parental_consent")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  accounts                   Account[]
  sessions                   Session[]
  learningProfile            LearningProfile?
  diagnosticResults          DiagnosticResult[]
  parentalConsent            ParentalConsent?
  accessibilityPreferences AccessibilityPreferences?
  userProgress               UserProgress[]
  sentMessages               Message[]
  conversationParticipants ConversationParticipant[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model LearningProfile {
  id                         String    @id @default(cuid())
  userId                     String    @unique @map("user_id")
  learningStyle              String    @default("mixed") @map("learning_style")
  preferredPace              String    @default("medium") @map("preferred_pace")
  attentionSpanMinutes       Int       @default(20) @map("attention_span_minutes")
  subjectStrengthsWeaknesses Json      @map("subject_strengths_weaknesses")
  preferredTimeOfDay         String    @default("morning") @map("preferred_time_of_day")
  breakFrequencyMinutes      Int       @default(30) @map("break_frequency_minutes")
  multitaskingPreference     Boolean   @default(false) @map("multitasking_preference")
  sensoryProcessingNotes     String    @map("sensory_processing_notes")
  communicationPreferences   String    @default("mixed") @map("communication_preferences")
  executiveFunctionSupport   Boolean   @default(false) @map("executive_function_support")
  preferredRewardSystem      String    @default("progress") @map("preferred_reward_system")
  interestAreas              String    @map("interest_areas")
  feedbackStyle              String    @default("constructive") @map("feedback_style")
  assessmentFormat           String    @default("mixed") @map("assessment_format")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_profiles")
}

model DiagnosticResult {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  assessmentType  String   @map("assessment_type")
  score           Float
  confidence      Float
  indicators      Json
  recommendations Json
  completedAt     DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diagnostic_results")
}

model ParentalConsent {
  id                  String    @id @default(cuid())
  userId              String    @unique @map("user_id")
  parentName          String    @map("parent_name")
  parentEmail         String    @map("parent_email")
  relationshipToChild String    @map("relationship_to_child")
  consentGiven        Boolean   @default(false) @map("consent_given")
  consentDate         DateTime? @map("consent_date")
  ipAddress           String?   @map("ip_address")
  userAgent           String?   @map("user_agent")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parental_consents")
}

model AccessibilityPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  fontSize              Int      @default(16) @map("font_size")
  contrastMode          String   @default("default") @map("contrast_mode")
  enableTextToSpeech    Boolean  @default(false) @map("enable_text_to_speech")
  prefersReducedMotion  Boolean  @default(false) @map("prefers_reduced_motion")
  colorBlindnessSupport String   @default("none") @map("color_blindness_support")
  keyboardNavigation    Boolean  @default(true) @map("keyboard_navigation")
  screenReaderOptimized Boolean  @default(false) @map("screen_reader_optimized")
  focusIndicatorStyle   String   @default("default") @map("focus_indicator_style")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accessibility_preferences")
}

model LearningModule {
  id              String   @id @default(cuid())
  title           String
  description     String?
  subject         String
  targetAudience  String   @map("target_audience")
  difficultyLevel String   @default("beginner") @map("difficulty_level")
  estimatedTime   Int?     @map("estimated_time")
  isActive        Boolean  @default(true) @map("is_active")
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  contentBlocks ContentBlock[]
  userProgress  UserProgress[]

  @@map("learning_modules")
}

model ContentBlock {
  id              String   @id @default(cuid())
  moduleId        String   @map("module_id")
  title           String
  order           Int
  contentType     String   @map("content_type")
  contentData     Json     @map("content_data")
  difficultyLevel String   @default("beginner") @map("difficulty_level")
  isRequired      Boolean  @default(true) @map("is_required")
  estimatedTime   Int?     @map("estimated_time")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  module       LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userProgress UserProgress[]

  @@map("content_blocks")
}

model UserProgress {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  moduleId       String?   @map("module_id")
  contentBlockId String?   @map("content_block_id")
  status         String    @default("not_started")
  score          Float?
  timeSpent      Int?      @map("time_spent")
  attempts       Int       @default(0)
  lastAccessed   DateTime  @default(now()) @map("last_accessed")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  module       LearningModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contentBlock ContentBlock?   @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model Conversation {
  id           String   @id @default(cuid())
  subject      String?
  type         String   @default("general")
  status       String   @default("active")
  priority     String   @default("normal")
  isConfidential Boolean  @default(false) @map("is_confidential")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastActivity DateTime @default(now()) @map("last_activity")

  messages     Message[]
  participants ConversationParticipant[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  role           String
  canMessage     Boolean   @default(true) @map("can_message")
  canModerate    Boolean   @default(false) @map("can_moderate")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  messageType    String   @default("text") @map("message_type")
  isEdited       Boolean  @default(false) @map("is_edited")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  readBy         Json     @map("read_by")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
} 